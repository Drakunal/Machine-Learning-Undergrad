import pandas as pd
from sklearn.preprocessing import MultiLabelBinarizer
from sklearn.metrics.pairwise import cosine_similarity
from rapidfuzz import process

# Load datasets
movies_df = pd.read_csv("movies.csv")
ratings_df = pd.read_csv("ratings.csv")

# Preprocess genres
movies_df['genres'] = movies_df['genres'].str.replace('|', ', ', regex=False)
movies_df['genre_list'] = movies_df['genres'].str.split(', ')
mlb = MultiLabelBinarizer()
genre_df = pd.DataFrame(mlb.fit_transform(movies_df['genre_list']), columns=mlb.classes_)
cosine_sim = cosine_similarity(genre_df)

# Mapping
movie_indices = pd.Series(movies_df.index, index=movies_df['title'])
movie_id_to_index = pd.Series(movies_df.index.values, index=movies_df['movieId'])

# Combined function: history + recommendations
def recommend_for_user(user_id, top_n=5):
    if user_id not in ratings_df['userId'].unique():
        return None, None, f"User ID {user_id} not found."

    # --- Past ratings ---
    user_ratings = ratings_df[ratings_df['userId'] == user_id]
    user_history = user_ratings.merge(movies_df, on='movieId')[['title', 'rating', 'genres']]
    user_history = user_history.sort_values(by='rating', ascending=False)

    # --- Recommendations ---
    top_rated = user_ratings[user_ratings['rating'] >= 4.5]
    top_movie_ids = top_rated['movieId'].values
    valid_indices = [movie_id_to_index[mid] for mid in top_movie_ids if mid in movie_id_to_index]

    if not valid_indices:
        return user_history, None, f"No high-rated movies found for recommendations."

    # Sum cosine similarities
    sim_scores = sum([cosine_sim[i] for i in valid_indices])
    sim_scores = list(enumerate(sim_scores))
    sim_scores = sorted(sim_scores, key=lambda x: x[1], reverse=True)

    rated_ids = set(user_ratings['movieId'])
    recommended = []
    for idx, _ in sim_scores:
        movie_id = movies_df.iloc[idx]['movieId']
        if movie_id not in rated_ids:
            recommended.append(idx)
        if len(recommended) == top_n:
            break

    recommendations = movies_df.iloc[recommended][['title', 'genres']]
    return user_history, recommendations, None

# --- User interaction ---
print("\n User Movie History + Recommendations")
try:
    user_id = int(input("Enter a User ID (e.g. 1): "))
    history, recs, error = recommend_for_user(user_id)

    if error:
        print("\n error", error)
    else:
        print(f"\n Past Ratings by User {user_id}:\n")
        print(history.to_string(index=False))
        print(f"\n Recommended Movies for User {user_id}:\n")
        print(recs.to_string(index=False))

except ValueError:
    print("Please enter a valid numeric user ID.")
